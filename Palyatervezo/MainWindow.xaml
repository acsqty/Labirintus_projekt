<Window x:Class="Palyatervezo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pályatervező" Height="700" Width="1050"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#2d2d2d" Foreground="White">
            <MenuItem Header="Fájl" x:Name="menuFajl">
                <MenuItem Header="Új" x:Name="menuUj" Click="MenuUj_Click"/>
                <MenuItem Header="Megnyitás" x:Name="menuMegnyitas" Click="MenuMegnyitas_Click"/>
                <MenuItem Header="Mentés" x:Name="menuMentes" Click="MenuMentes_Click"/>
                <Separator/>
                <MenuItem Header="Kilépés" x:Name="menuKilepes" Click="MenuKilepes_Click"/>
            </MenuItem>
            <MenuItem Header="Nyelv" x:Name="menuNyelv">
                <MenuItem Header="Magyar" Click="MenuMagyar_Click"/>
                <MenuItem Header="English" Click="MenuEnglish_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#2d2d2d">
            <TextBlock x:Name="txtStatus" Foreground="White" Text="Termek: 0"/>
        </StatusBar>

        <StackPanel DockPanel.Dock="Left" Width="165" Background="#2d2d2d" Margin="5">
            <TextBlock x:Name="txtPaletteTitle" Text="Karakterek:" Foreground="White" Margin="5" FontWeight="Bold"/>
            <WrapPanel x:Name="palettePanel" Margin="5"/>

            <Separator Margin="5"/>

            <TextBlock x:Name="txtMapSizeLabel" Text="Térkép mérete:" Foreground="White" Margin="5"/>
            <StackPanel Orientation="Horizontal" Margin="5,2">
                <TextBlock x:Name="txtRowLabel" Text="Sor:" Foreground="White" Width="55" VerticalAlignment="Center"/>
                <TextBox x:Name="txtRows" Width="45" Text="15"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,2">
                <TextBlock x:Name="txtColLabel" Text="Oszlop:" Foreground="White" Width="55" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCols" Width="45" Text="20"/>
            </StackPanel>
            <Button x:Name="btnNewMap" Content="Új térkép" Margin="5,8,5,5" Click="BtnNewMap_Click" Background="#444" Foreground="White" Padding="5"/>

            <Separator Margin="5"/>

            <TextBlock x:Name="txtInfoTitle" Text="Információ:" Foreground="White" Margin="5" FontWeight="Bold"/>
            <TextBlock x:Name="txtRooms" Text="Termek: 0" Foreground="Gold" Margin="5,2"/>
        </StackPanel>

        <ScrollViewer Background="#1e1e1e" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="mapGrid" Margin="10"/>
        </ScrollViewer>
    </DockPanel>
</Window>
